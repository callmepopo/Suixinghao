# For an iOS build signed by YOUR Apple account and YOUR registered App ID.
# All values intentionally empty. Do not commit the completed file or .p8 key.
# Paste the completed assignments into the private service.env.
VOICE_WEB_APNS_TEAM_ID=
VOICE_WEB_APNS_BUNDLE_ID=
VOICE_WEB_APNS_SANDBOX_KEY_FILE=
VOICE_WEB_APNS_SANDBOX_KEY_ID=
VOICE_WEB_APNS_PRODUCTION_KEY_FILE=
VOICE_WEB_APNS_PRODUCTION_KEY_ID=
# KEY_FILE must reference a root-readable 0600 .p8 file outside the checkout.
# Debug uses sandbox; TestFlight and App Store use production.
# No certificates, private keys or sample private-key contents are included.
