# Shell assignments. This file is sourced by service.sh; keep it root-owned 0600.
VOICE_WEB_UPSTREAM=http://127.0.0.1:7577
VOICE_WEB_CONFIG_FILE=/mnt/user/appdata/hideck/config/config.yaml
VOICE_WEB_DEVICE_ID=eth1
VOICE_WEB_DATA_DIR=/mnt/user/appdata/suixinghao
VOICE_WEB_MODULE_ROUTE=/mnt/user/appdata/suixinghao/module-route.sh
VOICE_WEB_AUDIO_DEVICE=hw:CARD=Baiwang,DEV=0
VOICE_WEB_ADDR=127.0.0.1:7581
VOICE_WEB_ALLOWED_ORIGINS=https://voice.example.org

# The supervisor uses DATA_DIR/voice-web if unset.
# VOICE_WEB_BINARY=/mnt/user/appdata/suixinghao/voice-web
VOICE_WEB_ADB=/usr/bin/adb
# Required for voice: fill only after inspecting your own authorized module.
VOICE_WEB_ADB_SERIAL=
VOICE_WEB_MODULE_USB_DEVICE=
VOICE_WEB_MODULE_ASSETS=/mnt/user/appdata/suixinghao/drivers/module-voice

# Persistent defaults under DATA_DIR; override only when needed.
# VOICE_WEB_APP_KEYS_FILE=/mnt/user/appdata/suixinghao/app-keys.json
# VOICE_WEB_RECORDING_FILE=/mnt/user/appdata/suixinghao/recording.json
# VOICE_WEB_CONNECTION_HISTORY_FILE=/mnt/user/appdata/suixinghao/connection-history.json

# Optional: self-built/signed iOS app with YOUR Apple account only.
# Add your private APNs assignments from apns-self-build.env.example here.
# Public App Store push relay is not implemented. Never request the publisher's key.
