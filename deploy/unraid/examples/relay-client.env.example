# 用户自建电话服务使用；发布者的 Apple 私钥不放这里。
VOICE_WEB_PUSH_RELAY_URL=https://relay.example.org/push-relay/v1/push
VOICE_WEB_PUSH_RELAY_KEY_FILE=

# 同一服务同时支持开发包及TestFlight时，每个环境使用独立的完整配置对。
# 显式配置不完整时拒绝推送，不借用默认凭据。
# VOICE_WEB_PUSH_RELAY_URL_SANDBOX=https://relay.example.org/sandbox/push-relay/v1/push
# VOICE_WEB_PUSH_RELAY_KEY_FILE_SANDBOX=/private/sandbox-relay.key
# VOICE_WEB_PUSH_RELAY_URL_PRODUCTION=https://relay.example.org/push-relay/v1/push
# VOICE_WEB_PUSH_RELAY_KEY_FILE_PRODUCTION=/private/production-relay.key
