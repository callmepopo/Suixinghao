# 发布者私有进程；复制到仓库外，按实际宿主与反代网络填写。
VOICE_WEB_DATA_DIR=
VOICE_WEB_RELAY_ADDR=127.0.0.1:7582
VOICE_WEB_RELAY_ENVIRONMENT=production
VOICE_WEB_APNS_BUNDLE_ID=com.junpo.suixinghao
VOICE_WEB_APNS_TEAM_ID=
VOICE_WEB_APNS_PRODUCTION_KEY_ID=
VOICE_WEB_APNS_PRODUCTION_KEY_FILE=
# sandbox 实例改环境，并使用对应 sandbox 参数；不复用旧 App 的 topic 授权。
VOICE_WEB_APNS_SANDBOX_KEY_ID=
VOICE_WEB_APNS_SANDBOX_KEY_FILE=

# 受控自动绑定：未启用时所有自动开通接口返回503，原手工推送不变。
VOICE_WEB_RELAY_AUTO_ENROLL=0
# 从发布者Apple资产核对App ID前缀；不得使用客户端提交的值。
VOICE_WEB_APP_ATTEST_APP_ID=
